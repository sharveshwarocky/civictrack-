# CivicTrack environment variables — copy to .env and fill in real values.

# Supabase project URL (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose to the browser)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service_role key (SECRET — used only by scripts like `npm run purge`.
# Never expose this in the client bundle. Only add to Vercel if you run scripts server-side.)
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
